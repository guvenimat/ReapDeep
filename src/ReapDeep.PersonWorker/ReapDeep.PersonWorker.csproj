<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WarningsNotAsErrors>IL2104</WarningsNotAsErrors>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Confluent.Kafka" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.AOT" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReapDeep.Analytics\ReapDeep.Analytics.csproj" />
    <ProjectReference Include="..\ReapDeep.ServiceDefaults\ReapDeep.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
