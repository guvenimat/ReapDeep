    {
      "type": "timeseries",
      "title": "Events per second by project",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (project_id) (rate(reapdeep_ingestion_events_accepted_total[$__rate_interval]))",
          "legendFormat": "project {{project_id}}"
        }
